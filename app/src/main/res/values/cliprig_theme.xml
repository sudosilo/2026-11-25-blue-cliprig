<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="blue">#1E6BFF</color>
    <color name="blue_dark">#0F4FCC</color>
    <color name="blue_soft">#E8F0FF</color>
    <color name="ink">#1A2233</color>
    <color name="paper">#F7F9FC</color>

    <style name="Theme.Cliprig" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/blue_dark</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="Theme.Cliprig.Play" parent="Theme.Cliprig">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
